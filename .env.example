SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=3002

# AI reading
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google Play coin purchases (see billing.js, data/coins_5_billing.sql)
