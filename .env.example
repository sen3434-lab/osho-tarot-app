BILLING_SECRET=
GOOGLE_SERVICE_ACCOUNT_FILE=/root/apps/secrets/play-service-account.json
# Only if the Play package name differs from the default
# GOOGLE_PLAY_PACKAGE=com.ozma.oshozentarot
